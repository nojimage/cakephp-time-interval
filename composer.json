{
    "name": "elstc/cakephp-time-interval",
    "license": "MIT",
    "description": "TimeInterval type plugin for CakePHP",
    "type": "cakephp-plugin",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "cakephp/migrations": "^4.0",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.0.9"
    },
    "autoload": {
        "psr-4": {
            "Elastic\\TimeInterval\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elastic\\TimeInterval\\Test\\": "tests",
            "TestApp\\": "tests/test_app/TestApp",
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs -p --extensions=php ./src ./tests",
        "cs-fix": "phpcbf -p --extensions=php ./src ./tests",
        "update-lowest": "composer update --prefer-lowest --prefer-stable"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
